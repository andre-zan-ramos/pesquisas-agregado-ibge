{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agregados-ibge:contrato:v1",
  "title": "Contrato interno v1: exemplos e limites estruturais, sem rotas novas nesta fase",
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9]+$"},
    "nivelId": {"type": "string", "pattern": "^N[0-9]+$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "classificacaoSelecionada": {
      "type": "object", "additionalProperties": false,
      "required": ["classificacao_id", "categoria_ids"],
      "properties": {"classificacao_id": {"$ref": "#/$defs/id"}, "categoria_ids": {"$ref": "#/$defs/ids"}}
    },
    "consulta": {
      "type": "object", "additionalProperties": false,
      "required": ["agregado_id", "nivel_id", "localidade_ids", "variavel_ids", "periodo_ids", "classificacoes"],
      "properties": {
        "agregado_id": {"$ref": "#/$defs/id"}, "nivel_id": {"$ref": "#/$defs/nivelId"},
        "localidade_ids": {"allOf": [{"$ref": "#/$defs/ids"}], "maxItems": 5},
        "variavel_ids": {"allOf": [{"$ref": "#/$defs/ids"}], "maxItems": 6},
        "periodo_ids": {"$ref": "#/$defs/ids"},
        "classificacoes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/classificacaoSelecionada"}}
      }
    },
    "proveniencia": {
      "type": "object",
      "required": ["source_url", "fetched_at", "expires_at", "cache_hit"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "cache_hit": {"type": "boolean"}
      }
    },
    "categoriaObservacao": {
      "type": "object", "additionalProperties": false,
      "required": ["classificacao_id", "classificacao_nome", "categoria_id", "categoria_nome", "categoria_unidade"],
      "properties": {
        "classificacao_id": {"$ref": "#/$defs/id"}, "classificacao_nome": {"type": "string"},
        "categoria_id": {"$ref": "#/$defs/id"}, "categoria_nome": {"type": "string"}, "categoria_unidade": {"type": ["string", "null"]}
      }
    },
    "observacao": {
      "type": "object", "additionalProperties": false,
      "required": ["agregado_id", "variavel_id", "variavel_nome", "unidade", "unidade_original", "unidade_status", "nivel_id", "localidade_id", "localidade_nome", "periodo_id", "classificacoes", "valor_original", "valor_numerico", "valor_status", "origem_indice"],
      "properties": {
        "agregado_id": {"$ref": "#/$defs/id"}, "variavel_id": {"$ref": "#/$defs/id"},
        "variavel_nome": {"type": "string"}, "unidade": {"type": ["string", "null"]},
        "unidade_original": {"type": ["string", "null"]}, "unidade_status": {"enum": ["coerente", "nao_confirmada", "conflitante"]},
        "nivel_id": {"$ref": "#/$defs/nivelId"}, "localidade_id": {"$ref": "#/$defs/id"}, "localidade_nome": {"type": "string"},
        "periodo_id": {"$ref": "#/$defs/id"},
        "classificacoes": {"type": "array", "items": {"$ref": "#/$defs/categoriaObservacao"}},
        "valor_original": {"type": ["string", "number", "null"]},
        "valor_numerico": {"type": ["number", "null"]},
        "valor_status": {"enum": ["numerico", "marcador", "vazio", "nulo", "nao_reconhecido"]},
        "origem_indice": {
          "type": "object", "additionalProperties": false,
          "required": ["variavel", "resultado", "serie"],
          "properties": {"variavel": {"type": "integer", "minimum": 0}, "resultado": {"type": "integer", "minimum": 0}, "serie": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "warning": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {}}
    },
    "analise": {
      "type": "object", "additionalProperties": false,
      "required": ["variavel_id", "variavel_nome", "nivel_id", "localidade_id", "localidade_nome", "classificacoes", "unidade", "suspensa", "n", "sem_numero", "media", "desvio", "cv", "minimo", "maximo", "periodos_min", "periodos_max", "grafico_linhas", "pontos", "avisos"],
      "properties": {
        "variavel_id": {"$ref": "#/$defs/id"}, "variavel_nome": {"type": "string"},
        "nivel_id": {"$ref": "#/$defs/nivelId"}, "localidade_id": {"$ref": "#/$defs/id"}, "localidade_nome": {"type": "string"},
        "classificacoes": {"type": "array", "items": {"$ref": "#/$defs/categoriaObservacao"}},
        "unidade": {"type": ["string", "null"]}, "suspensa": {"type": "boolean"},
        "n": {"type": "integer", "minimum": 0}, "sem_numero": {"type": "integer", "minimum": 0},
        "media": {"type": ["number", "null"]}, "desvio": {"type": ["number", "null"]}, "cv": {"type": ["number", "null"]},
        "minimo": {"type": ["number", "null"]}, "maximo": {"type": ["number", "null"]},
        "periodos_min": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "periodos_max": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "grafico_linhas": {"type": "boolean"}, "avisos": {"type": "array", "items": {"type": "string"}},
        "pontos": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["periodo_id", "valor", "lacuna"], "properties": {"periodo_id": {"$ref": "#/$defs/id"}, "valor": {"type": ["number", "null"]}, "lacuna": {"type": "boolean"}}}}
      }
    },
    "dadosResultado": {
      "type": "object", "additionalProperties": false,
      "required": ["consulta_aplicada", "observacoes", "metadados", "warnings", "truncated", "normalizer_version"],
      "properties": {
        "consulta_aplicada": {"$ref": "#/$defs/consulta"},
        "observacoes": {"type": "array", "items": {"$ref": "#/$defs/observacao"}},
        "metadados": {"$ref": "#/$defs/metadados"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
        "truncated": {"const": false}, "normalizer_version": {"const": "v1"},
        "corpo_original": {"type": "array"},
        "periodos_apresentacao": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "ordem_cronologica": {"type": "boolean"},
        "analises": {"type": "array", "items": {"$ref": "#/$defs/analise"}}
      }
    },
    "resultado": {
      "type": "object", "additionalProperties": false, "required": ["data", "sources"],
      "properties": {"data": {"$ref": "#/$defs/dadosResultado"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proveniencia"}}}
    },
    "paginacao": {
      "type": "object", "additionalProperties": false,
      "required": ["page", "page_size", "total_count", "has_next"],
      "properties": {"page": {"type": "integer", "minimum": 1}, "page_size": {"type": "integer", "minimum": 1, "maximum": 200}, "total_count": {"type": ["integer", "null"], "minimum": 0}, "has_next": {"type": ["boolean", "null"]}}
    },
    "itemDominio": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "nome"], "properties": {"id": {"type": "string"}, "nome": {"type": "string"}}
    },
    "metadados": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "nome", "sidra_url", "pesquisa", "assunto", "periodicidade", "niveis", "variaveis", "classificacoes", "periodos"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "nome": {"type": "string"}, "sidra_url": {"type": "string", "format": "uri"},
        "pesquisa": {"type": "string"}, "assunto": {"type": "string"},
        "periodicidade": {"type": "object", "required": ["frequencia", "inicio", "fim"], "additionalProperties": false,
          "properties": {"frequencia": {"type": "string"}, "inicio": {"type": "string"}, "fim": {"type": "string"}}},
        "niveis": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "nome", "grupo"],
          "properties": {"id": {"$ref": "#/$defs/nivelId"}, "nome": {"type": ["string", "null"]}, "grupo": {"type": "string"}}}},
        "variaveis": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "nome", "unidade", "sumarizacao"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "nome": {"type": "string"}, "unidade": {"type": ["string", "null"]}, "sumarizacao": {"type": "array", "items": {"type": "string"}}}}},
        "classificacoes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "nome", "sumarizacao", "categorias"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "nome": {"type": "string"},
            "sumarizacao": {"type": "object", "additionalProperties": false, "required": ["status", "excecao"], "properties": {"status": {"type": "boolean"}, "excecao": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
            "categorias": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "nome", "unidade", "nivel"], "properties": {"id": {"$ref": "#/$defs/id"}, "nome": {"type": "string"}, "unidade": {"type": ["string", "null"]}, "nivel": {"type": ["integer", "null"], "minimum": 0}}}}
          }}},
        "periodos": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "literals", "modificacao", "ordem"], "properties": {"id": {"$ref": "#/$defs/id"}, "literals": {"type": "array", "items": {"type": "string"}}, "modificacao": {"type": ["string", "null"]}, "ordem": {"type": "integer", "minimum": 0}}}}
      }
    },
    "erro": {
      "type": "object", "additionalProperties": false, "required": ["error"],
      "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "details"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {}}}}
    }
  }
}
